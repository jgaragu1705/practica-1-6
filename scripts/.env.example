# Datos para el certificado de Let's Encrypt
LETS_ENCRYPT_DOMAIN=
LETS_ENCRYPT_EMAIL=

# Datos de la base de datos de WordPress
DB_NAME=wordpress
DB_USER=wp_user
DB_PASSWORD=
DB_HOST=localhost
# Desde dónde se puede conectar el usuario a MySQL (localhost, %, una IP...)
IP_CLIENTE_MYSQL=localhost

# Datos del sitio y del usuario administrador de WordPress
WORDPRESS_TITLE="Mi sitio WordPress"
WORDPRESS_ADMIN_USER=
WORDPRESS_ADMIN_PASSWORD=
WORDPRESS_ADMIN_EMAIL=

# Ruta personalizada para entrar al panel (en vez de /wp-admin)
URL_HIDE_LOGIN=
